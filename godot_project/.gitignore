# Godot 4 .gitignore
.godot/
.import/
export.cfg

# export_presets.cfg ОТСЛЕЖИВАЕМ, вопреки шаблону Godot: в нём нет ни ключей
# подписи, ни паролей — только настройки сборки, и без него собрать те же
# бинарники на другой машине нельзя.
*.translation
.mono/
data_*/
mono_crash.*.json

# Временные копии GDExtension, которые Godot делает при горячей перезагрузке.
~*.dll
