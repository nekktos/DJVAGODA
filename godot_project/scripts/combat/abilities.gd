extends RefCounted
##
## Способности: поддержка эльфов (GDD 8.4) и магия злодея (GDD 3.2).
##
## Обе стороны живут в одной таблице и на одном откате намеренно: механика у них
## одна — «нажал, хост посчитал, откат поехал по сети», — а различается только
## то, что происходит в середине. Заводить злодею вторую систему значило бы
## писать второй откат, вторую репликацию и вторую очередь заявок ради того же
## самого.
##
## Клавиши 4/5/6 у каждой стороны свои: эльфам лечение, клич и призыв, злодею —
## паралич, увядание и слепота (`FACTIONS.ABILITY_SETS`).
##
## ПОЧЕМУ ОТДЕЛЬНО ОТ ОРУЖИЯ. В `weapons.gd` всё заточено под атаку: урон,
## дальность полёта снаряда, зона поражения. Лечение и клич не имеют ни урона,
## ни цели-врага, а призыв вообще не бьёт — впихнув их в тот же enum, пришлось
## бы всюду городить исключения «а вот у этого урона нет». Поэтому способности
## живут своей таблицей и своим кулдауном, а оружие остаётся оружием.
##
## Считает способности ТОЛЬКО хост — как урон и ресурсы. Клиент лишь просит и
## показывает откат, который ему прислали.
##

## Новые виды ДОПИСАНЫ В КОНЕЦ: номер едет по сети и лежит в сохранениях.
enum Kind { HEAL, RALLY, SUMMON, PARALYSIS, WITHER, BLIND }

const COUNT := 6

const NAMES := ["лечение", "клич леса", "призыв волка",
	"паралич воли", "проклятие увядания", "слепящее проклятие"]

## Откат, секунды.
const COOLDOWN := [8.0, 22.0, 30.0, 28.0, 14.0, 18.0]

## Радиус действия, метры. У призыва это не радиус действия, а то, как далеко
## от эльфа появляется волк.
const RANGE := [12.0, 18.0, 5.0, 20.0, 18.0, 22.0]

## Сколько здоровья возвращает лечение.
##
## Лечение НЕ отращивает отрубленное — на то есть протезы (GDD раздел 4).
## Оно закрывает ровно то, что GDD называет «вылечат — жив»: останавливает
## кровотечение и поднимает здоровье.
const HEAL_AMOUNT := 45.0

## Клич леса: сколько держится и насколько ускоряет.
const RALLY_DURATION := 12.0
const RALLY_SPEED_SCALE := 1.35
## Множитель отката атак: меньше единицы — бьют чаще.
const RALLY_ATTACK_SCALE := 0.72

## Волк живёт минуту и исчезает: бессрочный призыв превратился бы в бесплатный
## отряд, а отряд по GDD — механика злодея, не эльфов.
const SUMMON_LIFETIME := 60.0
## Больше двух одновременно эльфу не удержать.
const SUMMON_LIMIT := 2


# --- магия злодея (GDD 3.2) ------------------------------------------------

## Паралич воли — тот самый «контроль разума» из исходной идеи.
##
## НАД ЖИВЫМ ИГРОКОМ БУКВАЛЬНОГО ПЕРЕХВАТА УПРАВЛЕНИЯ НЕТ И НЕ БУДЕТ. Это
## решение, а не недоделка: отобрать у человека контроль над персонажем на
## несколько секунд — самое нечестное, что один игрок может сделать с другим.
## По игроку это жёсткий CC и ничего больше; по НАЁМНОМУ существу — переход под
## контроль кастующего, там это уместно и приятно как контрприём против
## друидических призывов.
##
## Каст видимый и прерывается уроном — без этого эффект ощущается читерским.
const PARALYSIS_CAST := 1.75
## Сколько игрок стоит парализованным. Короче любого эльфийского баффа: тяжёлый
## контроль обязан быть коротким.
const PARALYSIS_HOLD := 3.0
## Наёмник под контролем держится дольше: он не человек, и ему не обидно.
const PARALYSIS_CHARM := 8.0
## Окно неуязвимости к повторному параличу после снятия. Без него двое злодеев
## держали бы игрока в вечном контроле цепочкой кастов.
const PARALYSIS_IMMUNITY := 25.0

## Проклятие увядания: кровотечение плюс ослабление наносимого урона.
const WITHER_DURATION := 8.0
## Множитель урона проклятого. Не ноль: он должен драться хуже, а не перестать.
const WITHER_DAMAGE_SCALE := 0.65

## Слепящее проклятие: половина экрана закрыта на время действия.
const BLIND_DURATION := 7.0


## Требует ли способность каста на виду у цели.
static func cast_time(kind: int) -> float:
	return PARALYSIS_CAST if kind == Kind.PARALYSIS else 0.0


static func name_of(kind: int) -> String:
	return NAMES[clampi(kind, 0, COUNT - 1)]


static func cooldown_of(kind: int) -> float:
	return COOLDOWN[clampi(kind, 0, COUNT - 1)]


static func range_of(kind: int) -> float:
	return RANGE[clampi(kind, 0, COUNT - 1)]
