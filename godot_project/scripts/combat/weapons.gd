extends RefCounted
##
## Данные об оружии (GDD разделы 3 и 3.1).
##
## Меч и лук — общая база у всех сторон. Сверх неё каждая сторона получает ОДНО
## эксклюзивное тяжёлое оружие, выражающее её характер: эльфам топор, злодею
## молот, страже арбалет. Так сделано вместо «у всех всё»: девять видов оружия на
## сторону — это девять анимаций и почти никакой играбельной разницы, ровно та же
## логика, по которой уровень снаряжения не заводили на каждое оружие отдельно.
##
## Новые виды ДОПИСАНЫ В КОНЕЦ перечисления. Номер вида едет по сети и лежит в
## сохранениях, и вставка в середину молча переименовала бы оружие в чужих руках.
##
## Балансные числа держим здесь одним местом, чтобы правка не расползалась по
## коду персонажа и снарядов.
##

enum Kind { SWORD, BOW, SPELL, AXE, HAMMER, CROSSBOW }

const NAMES := {
	Kind.SWORD: "меч",
	Kind.BOW: "лук",
	Kind.SPELL: "огненный шар",
	Kind.AXE: "топор",
	Kind.HAMMER: "молот",
	Kind.CROSSBOW: "арбалет",
}

## Задержка между ударами, секунды. Проверяется ХОСТОМ — клиентский кулдаун
## нужен только чтобы не слать заведомо лишние заявки.
const COOLDOWN := {
	Kind.SWORD: 0.7,
	Kind.BOW: 1.0,
	Kind.SPELL: 1.5,
	# Топор быстрее меча, молот заметно медленнее, арбалет медленнее лука.
	Kind.AXE: 0.55,
	Kind.HAMMER: 1.25,
	Kind.CROSSBOW: 1.6,
}

const DAMAGE := {
	Kind.SWORD: 35.0,
	Kind.BOW: 30.0,
	Kind.SPELL: 45.0,
	# Топор бьёт слабее меча за удар, но чаще: 51 в секунду против 50 — почти
	# поровну, разница в РИСУНКЕ боя, а не в числах. Добавку даёт кровотечение.
	Kind.AXE: 28.0,
	# Молот: 42 в секунду, ниже меча. Он покупается не уроном, а тем, что сбивает.
	Kind.HAMMER: 52.0,
	# Арбалет: 27 в секунду против 30 у лука, зато пробивает снаряжение.
	Kind.CROSSBOW: 44.0,
}

## Чем можно ОТРУБИТЬ конечность, а чем — только вывести её из строя.
##
## Стрела не отрубает руку. Она её пробивает: рука остаётся на месте, но не
## работает — держать оружие и стрелять ей нельзя. То же у болта и у магии.
## Молот тоже в этом списке: он не режет, он ломает, и сломанная рука — это
## именно покалеченная, а не отрубленная (и это рифмуется с его оглушением).
##
## Отрубить может только то, чем рубят: меч и топор. Список НЕ по исключению
## («всё, кроме лука»), а по перечислению: новое оружие должно попадать в
## «калечит» молча и по умолчанию — это безопасная сторона ошибки.
const CUTTING := [Kind.SWORD, Kind.AXE]


## Отрубает ли это оружие конечность. Неизвестное оружие (-1) — не отрубает.
static func severs(kind: int) -> bool:
	return CUTTING.has(kind)


## Дальность удара в ближнем бою, метры. У молота длиннее — это двуручное древко.
const MELEE_RANGE := {
	Kind.SWORD: 2.6,
	Kind.AXE: 2.5,
	Kind.HAMMER: 3.0,
}

## Топор оставляет кровоточащую рану сверх урона — партизанский стиль «изматывать»,
## а не «убить с одного удара». Доля ударов, после которых цель начинает кровить.
const AXE_BLEED_CHANCE := 0.35

## Молот сбивает: цель на это время не может бить и колдовать. Число маленькое
## намеренно — это прерывание, а не оглушение до смерти.
const HAMMER_STAGGER := 1.1

## Какую долю снаряжения цели арбалетный болт игнорирует. Единица означала бы
## «снаряжение бесполезно», ноль — «ничем не отличается от лука».
const CROSSBOW_PIERCE := 0.6

## Насколько эффективнее оружие на добыче своего материала. Топор для дерева,
## молот для камня: тем же ударом, которым дерутся, и работают.
const HARVEST_BONUS := {
	Kind.AXE: {0: 2.0},
	Kind.HAMMER: {1: 2.0},
}

## Дальность удара мечом, метры.
const SWORD_RANGE := 2.6
## Полуугол сектора поражения мечом, радианы (примерно 50 градусов в каждую сторону).
const SWORD_HALF_ANGLE := 0.9

const PROJECTILE_SPEED := {
	Kind.BOW: 55.0,
	Kind.SPELL: 32.0,
	Kind.CROSSBOW: 70.0,
}

## Радиус взрыва огненного шара, метры. У стрелы площади нет.
const SPELL_BLAST_RADIUS := 6.0
## Сколько секунд снаряд живёт, если ни во что не попал.
const PROJECTILE_LIFETIME := 6.0


static func is_projectile(kind: int) -> bool:
	return kind == Kind.BOW or kind == Kind.SPELL or kind == Kind.CROSSBOW


## Оружие ближнего боя. Всё, что не снаряд.
static func is_melee(kind: int) -> bool:
	return not is_projectile(kind)


## Дальность удара для оружия ближнего боя.
static func melee_range(kind: int) -> float:
	return float(MELEE_RANGE.get(kind, SWORD_RANGE))


## Во сколько раз больше ресурса даёт удар этим оружием по этому источнику.
static func harvest_bonus(kind: int, resource_kind: int) -> float:
	var table: Dictionary = HARVEST_BONUS.get(kind, {})
	return float(table.get(resource_kind, 1.0))


## Оружие, которое тратит стрелы.
##
## Перечислением, а не «всё, что не ближний бой»: заклинание тоже дальнобойное,
## но платит оно маной. Ошибиться здесь значит либо дать луку стрелять вечно,
## либо потребовать стрелу за огненный шар.
const QUIVERED := [Kind.BOW, Kind.CROSSBOW]


static func uses_arrows(kind: int) -> bool:
	return QUIVERED.has(kind)


## Качество снаряжения (Этап 8, GDD раздел 2.1 — «покупка снаряжения, апгрейдов»).
##
## Уровень один на персонажа, а не на каждое оружие отдельно: три вида оружия
## умножить на три уровня — это девять состояний, которые надо реплицировать и
## балансировать, а играбельной разницы против одного «во что ты снаряжён» почти
## нет. Если позже понадобится точность Daggerfall, разворачивать будем отсюда.
const GEAR_TIERS := 3
const GEAR_NAMES := ["простое", "калёное", "эльфийское"]
## Множитель урона по уровню снаряжения.
const GEAR_DAMAGE := [1.0, 1.25, 1.55]
## Множитель отката: меньше единицы — бьют чаще.
const GEAR_COOLDOWN := [1.0, 0.92, 0.85]


static func gear_damage(tier: int) -> float:
	return GEAR_DAMAGE[clampi(tier, 0, GEAR_TIERS - 1)]


static func gear_cooldown(tier: int) -> float:
	return GEAR_COOLDOWN[clampi(tier, 0, GEAR_TIERS - 1)]


static func gear_name(tier: int) -> String:
	return GEAR_NAMES[clampi(tier, 0, GEAR_TIERS - 1)]
