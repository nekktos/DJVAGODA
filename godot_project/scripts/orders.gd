extends RefCounted
##
## Приказы командира (Этап 9). GDD раздел 2.2: страж подчиняется командиру,
## NPC отдаёт задания, оборона дворца и набеги по приказу.
##
## Приказы намеренно собраны из уже работающих механик, а не из новых: удержание
## точки — это objective.gd, «проредить войско» — боевая петля, набег — карта,
## перехват — караван Этапа 5. Кампания стражи должна связать сделанное, а не
## нарастить ещё один слой.
##
## Награда — золото и железо, то есть та же валюта, что в лавке Этапа 8. Иначе
## приказы не на что менять и подчиняться командиру незачем.
##

## Новые виды ДОБАВЛЯЮТСЯ В КОНЕЦ: номер приказа уходит в сеть и в сохранение.
##
## С 28.09 (GDD 9a) приказов девять. Три — по словам автора игры:
## СОПРОВОЖДЕНИЕ и защита обоза, ОБОРОНА дворца от нападения, ПОГОНЯ за теми,
## кто разграбил обоз. Два — мои: ОТБИТЬ ШАХТУ и РАЗОРИТЬ ПОЛЕ злодея.
enum Kind { HOLD, SLAY, RAID, INTERCEPT, FINAL, ESCORT, DEFEND, HUNT, MINE, FIELD }

## Круг службы. FINAL в круг не входит: он выдаётся вместо очередного, когда
## служба дослужена до порога. Первые три — прежние, в прежнем порядке: с них
## служба начинается и дальше.
##
## Приказ, который сейчас невыполним, при выдаче ПРОПУСКАЕТСЯ (`commander.gd`):
## погоня без грабителей, набег на поле, которого у злодея нет.
const ROTATION := [
	Kind.HOLD, Kind.SLAY, Kind.RAID, Kind.INTERCEPT,
	Kind.ESCORT, Kind.DEFEND, Kind.HUNT, Kind.MINE, Kind.FIELD,
]
const COUNT := 9
const KINDS := 10

## Сколько приказов надо сдать, чтобы принять командование стражей — и с ним
## вид сверху, стройку и наём (GDD 9a: «страже, чтоб стать руководителем
## стражи и открыть стратегический режим, надо пройти цепочку квестов»).
##
## Пять, как и обещало обучение стражи с первого дня («пять выполненных —
## повышение»). До 28.09 повышение давали по простому согласию командира, и
## обучение говорило неправду.
const ORDERS_FOR_PROMOTION := 5

## Сколько приказов надо сдать, чтобы командир доверил решающий удар.
## Число не жёсткое: откалибровать по playtest (GDD раздел 8).
const ORDERS_FOR_FINAL := 5

const NAMES := [
	"держать дворец",
	"проредить войско злодея",
	"набег на форт злодея",
	"перехватить караван",
	"последний бой",
	"сопроводить обоз",
	"оборонять дворец",
	"найти грабителей обоза",
	"отбить шахту",
	"разорить поле злодея",
]

## Что именно требуется сделать — текст для панели командира.
const BRIEFS := [
	"Стой в точке дворца, пока он наш. Нужно %d секунд.",
	"Убей %d бойцов или самого злодея.",
	"Дойди до форта злодея и вернись живым во дворец.",
	"Разбей %d караван злодея.",
	"Дойди до форта злодея и убей его сам. Это конец службы или конец тебя.",
	"Иди рядом с обозом стражи на обратном пути, пока он не доедет до склада.",
	"Убей %d чужих у стен дворца.",
	"Найди и убей %d из тех, кто грабил обоз стражи.",
	"Встань у любой шахты и продержись %d секунд, пока рядом нет чужих.",
	"Снеси поле злодея: без еды его батраки голодают.",
]

## Сколько нужно набрать, чтобы приказ считался выполненным.
## У набега две ступени: дошёл и вернулся.
const TARGETS := [25, 3, 2, 1, 1, 1, 3, 1, 20, 1]

## Награда за выполнение: [дерево, камень, золото, железо].
const REWARDS := [
	[0, 0, 40, 0],
	[0, 0, 60, 10],
	[0, 0, 90, 20],
	[0, 0, 120, 30],
	[0, 0, 300, 100],
	[0, 0, 70, 10],
	[0, 0, 60, 10],
	[0, 0, 90, 20],
	[0, 0, 70, 20],
	[0, 0, 80, 10],
]

## Сопровождение: насколько близко к обозу держаться и сколько секунд за
## обратный путь. Дойти до склада рядом с обозом в последний миг — не
## сопровождение.
const ESCORT_RADIUS := 40.0
const ESCORT_SECONDS := 20.0
## Оборона: насколько далеко от точки дворца убитый ещё считается нападавшим.
const DEFEND_RADIUS := 90.0
## Шахта: радиус поляны, где стоять и где не должно быть чужих.
const MINE_RADIUS := 45.0
## Погоня: кто в этом радиусе от обоза в миг грабежа — тот и грабитель.
const ROBBER_RADIUS := 30.0

## Куда идти в набег и с какой точностью. Форт злодея.
const RAID_POINT := Vector3(-300.0, 2.0, 296.0)
const RAID_RADIUS := 45.0

## На каком расстоянии от командира с ним можно говорить.
const TALK_RANGE := 8.0


static func name_of(kind: int) -> String:
	return NAMES[clampi(kind, 0, KINDS - 1)]


static func target_of(kind: int) -> int:
	return TARGETS[clampi(kind, 0, KINDS - 1)]


static func reward_of(kind: int) -> Array:
	return REWARDS[clampi(kind, 0, KINDS - 1)]


## Человекочитаемая задача. Для набега счётчик бессмысленный, там ступени.
static func brief_of(kind: int) -> String:
	var index := clampi(kind, 0, KINDS - 1)
	if index in [Kind.RAID, Kind.FINAL, Kind.ESCORT, Kind.FIELD]:
		return BRIEFS[index]
	return BRIEFS[index] % TARGETS[index]


## Как показать прогресс. У набега — словами, у остальных — счётчиком.
static func progress_text(kind: int, progress: int) -> String:
	var index := clampi(kind, 0, KINDS - 1)
	if index == Kind.FINAL:
		return "злодей ещё жив" if progress <= 0 else "выполнено"
	if index == Kind.ESCORT:
		return "проводи обоз до склада" if progress <= 0 else "выполнено"
	if index == Kind.FIELD:
		return "поле злодея стоит" if progress <= 0 else "выполнено"
	if index == Kind.MINE:
		return "%d из %d с" % [mini(progress, TARGETS[index]), TARGETS[index]]
	if index == Kind.RAID:
		if progress <= 0:
			return "идти к форту злодея"
		if progress == 1:
			return "форт достигнут, вернуться во дворец"
		return "выполнено"
	return "%d из %d" % [mini(progress, TARGETS[index]), TARGETS[index]]
