extends RefCounted
##
## Опыт и прокачка вожака (решение автора игры от 26-27.09.2026).
##
## ЗАЧЕМ ОПЫТ, А НЕ ЕДА. Первая задумка предлагала покупать прокачку едой.
## Решение автора: «прокачка не за еду должна быть, а всё-таки за опыт». Это
## разделило две разные вещи: еда кормит артель и кончается, опыт копится и не
## тратится ни на что, кроме тебя самого.
##
## ЗА ЧТО ДАЁТСЯ — тоже решение автора, дословно: «за добычу ресурсов, за
## убийства, за выращивание на ферме (добыча ресурсов), за успешную доставку
## караванов». Выращенное на ферме отдельной строки не требует: еда — ресурс,
## и доносится она на склад тем же путём, что дерево и камень. Одна запись
## вместо двух.
##
## ОПЫТ У ВОЖАКА, А НЕ У СТОРОНЫ. Прокачивается персонаж: его здоровье, его
## дыхание, его мана. Держать это в общей казне значило бы, что подвиги одного
## игрока качают другого — в игре, где за сторону играют несколько человек.
##
## ЧТО КАЧАЕТСЯ. Четыре шкалы, и все четыре — ПРИБАВКОЙ поверх базы, а не
## переписыванием константы. База остаётся тем, чем была: числом, к которому
## привязаны все остальные решения и проверки.
##

enum Stat { HEALTH, STAMINA, SPEED, MANA }

const COUNT := 4

const NAMES := ["здоровье", "выносливость", "бег", "мана"]

## Сколько даёт один уровень.
##
## Прибавки намеренно РАЗНЫЕ по ощущению: здоровье и мана прибавляются заметно,
## бег — по чуть-чуть. Пять уровней бега дают четверть скорости, и это уже
## много: быстрее бегущий вожак ломает и погоню, и отход.
const STEP_HEALTH := 15.0
const STEP_STAMINA := 20.0
const STEP_SPEED := 0.05
const STEP_MANA := 18.0

## Потолок по каждой шкале.
const MAX_LEVEL := 5

## Сколько опыта стоит СЛЕДУЮЩИЙ уровень. Дорожает линейно: первый уровень
## дёшев и достаётся почти сразу, пятый требует целой партии.
const COST_STEP := 40


## Цена перехода с уровня `level` на следующий. -1 — дальше некуда.
static func cost_of(level: int) -> int:
	if level < 0 or level >= MAX_LEVEL:
		return -1
	return COST_STEP * (level + 1)


static func name_of(stat: int) -> String:
	return NAMES[clampi(stat, 0, COUNT - 1)]


# --- за что даётся опыт ----------------------------------------------------

## Сколько единиц ресурса надо донести до склада за одно очко опыта.
##
## Считаем от ДОНЕСЁННОГО, а не от добытого — по тому же правилу, по которому
## и казна растёт только от донесённого. Иначе опыт капал бы за удары по дереву.
const RESOURCE_PER_POINT := 4

## За убитого бойца и за убитого вожака.
##
## Вожак дороже втрое: он не возрождается, и его смерть решает партию.
const XP_UNIT_KILL := 10
const XP_LEADER_KILL := 30

## За доехавший обоз. Дорого намеренно: обоз идёт через полкарты, его можно
## потерять, и довести его — это отдельная работа, а не побочный итог.
const XP_CARAVAN := 35
