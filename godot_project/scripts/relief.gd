extends RefCounted
##
## Рельеф карты: холмы вместо бильярдного стола.
##
## ГЛАВНОЕ ОГРАНИЧЕНИЕ, из которого следует всё остальное: весь мир построен на
## НУЛЕВОЙ высоте. Форт, дворец, деревня, дороги, спавны сторон, шахта — всё
## стоит на y=0 и рассчитано на плоскость. Опустить землю где-нибудь ниже нуля
## значит подвесить в воздухе то, что там стоит; поднять под постройкой — утопить
## её по окна.
##
## Поэтому холмы растут ТОЛЬКО ВВЕРХ и только там, где ничего нет. Плоская
## подложка на нуле остаётся как была: она и есть пол, на котором стоит игра.
## Рельеф — это добавка поверх, а не замена.
##
## ГДЕ ПЛОСКО. Дороги, зоны сторон, шахта, перекрёсток и полоса вдоль края
## карты. Не из осторожности, а по делу: по дороге ездит обоз, в зонах стоят
## дома, у края стоят стены мира. Маска гасит высоту в этих местах и плавно
## отпускает её дальше, чтобы холм не обрывался ступенькой.
##
## ПОЧЕМУ УКЛОН СЧИТАН, А НЕ ПОДОБРАН. Навигация печётся с `agent_max_slope`
## сорок пять градусов: круче — и сетка там просто не появится, а бойцы упрутся
## в невидимую стену посреди поля. Волны сделаны длинными (сотни метров) при
## небольшой высоте, отчего уклон нигде не доходит и до двадцати градусов.
##

## Сторона клетки сетки рельефа в метрах.
##
## Шестнадцать — не «на глаз»: при мире в 1200 метров это 75×75 клеток, то есть
## одиннадцать тысяч треугольников. Мельче — дольше печётся навигация (она берёт
## коллизию рельефа целиком), крупнее — холмы становятся гранёными.
const CELL := 16.0

## Насколько высоки холмы и насколько длинны их волны.
## Высота и длина волны подобраны ПО УКЛОНУ, а не по красоте: у длинной волны
## при той же высоте склон положе. Здесь худший уклон выходит около двадцати
## пяти градусов при потолке навигации в сорок пять — запас вдвое.
const BIG_HEIGHT := 22.0
const BIG_WAVE := 340.0
const SMALL_HEIGHT := 5.0
const SMALL_WAVE := 120.0

## Радиусы плоских пятен. Считаются от центра зоны и от дорог.
const ROAD_FLAT := 26.0
const ROAD_FADE := 70.0
## Плоское пятно вокруг зоны и переход за ним. Первый заход брал 165 и 245 —
## и холмам оставалась полоса метров в сто между зонами, отчего карта выглядела
## ровно так же плоско, как была.
const ZONE_FLAT := 120.0
const ZONE_FADE := 190.0
const SPOT_FLAT := 70.0
const SPOT_FADE := 130.0
## Насколько плоской остаётся полоса у края карты: там стоят стены мира.
const EDGE_FLAT := 45.0

var _big: FastNoiseLite
var _small: FastNoiseLite
## Точки, вокруг которых земля обязана быть плоской: центры зон, шахта, ноль.
var _flat_spots: Array = []
var _zone_spots: Array = []
var _half := 600.0


func _init(world_size: float, zone_centers: Array, spots: Array) -> void:
	_half = world_size * 0.5
	_zone_spots = zone_centers.duplicate()
	_flat_spots = spots.duplicate()
	_big = FastNoiseLite.new()
	_big.seed = 20260829
	_big.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	_big.frequency = 1.0 / BIG_WAVE
	_small = FastNoiseLite.new()
	_small.seed = 771177
	_small.noise_type = FastNoiseLite.TYPE_SIMPLEX_SMOOTH
	_small.frequency = 1.0 / SMALL_WAVE


## Высота земли в точке. Ноль — плоско, как было.
##
## Этой же функцией пользуется всё, что кладётся на землю: трава, камни,
## деревья. Иначе куст завис бы над склоном или ушёл в него по макушку — и
## искали бы причину в кусте, а не в том, что высоту считают дважды и по-разному.
func height(x: float, z: float) -> float:
	var mask := _mask(x, z)
	if mask <= 0.0:
		return 0.0
	# Шум даёт от -1 до 1, а земля обязана расти только ВВЕРХ: яма утопила бы
	# то, что на ней стоит. Переводим в 0..1 СДВИГОМ, а не обрезкой.
	#
	# Разница не косметическая. Обрезка (`max(шум, 0)`) даёт идеально плоские
	# блюдца всюду, где шум ушёл в минус, — а их края, где земля отрывается от
	# нуля, видны на глаз резкой линией: плоскость и склон затеняются по-разному,
	# и между ними получается кромка. На снимках это выглядело как зелёные
	# многоугольные заплаты по всему полю, и я успел списать их подряд на
	# текстуру, нормали, россыпь и тени, прежде чем понял, что заплаты — это
	# ровно те места, где я сам сделал землю идеально плоской.
	#
	# Степень чуть больше единицы оставляет низины пошире, а вершины поуже:
	# ровный синус читается как стиральная доска.
	var big: float = pow(_big.get_noise_2d(x, z) * 0.5 + 0.5, 1.6)
	var small: float = pow(_small.get_noise_2d(x, z) * 0.5 + 0.5, 1.6)
	return (big * BIG_HEIGHT + small * SMALL_HEIGHT) * mask


## Насколько в этой точке земле позволено подниматься: 0 — совсем нет, 1 — вся
## высота. Между ними плавный переход, иначе холм обрывается ступенькой.
func _mask(x: float, z: float) -> float:
	var m := 1.0
	# Дороги — крест через центр карты.
	m = minf(m, _ramp(absf(x), ROAD_FLAT, ROAD_FADE))
	m = minf(m, _ramp(absf(z), ROAD_FLAT, ROAD_FADE))
	for spot in _zone_spots:
		m = minf(m, _ramp(Vector2(x, z).distance_to(spot), ZONE_FLAT, ZONE_FADE))
	for spot in _flat_spots:
		# Пятно — либо точка с обычным радиусом, либо [точка, плоско, растушёвка].
		# Свой радиус нужен плато императора: оно 360 метров в поперечнике, и
		# обычных семидесяти ему мало — холмы перекрывали его собственную кромку.
		if spot is Array:
			m = minf(m, _ramp(Vector2(x, z).distance_to(spot[0]),
				float(spot[1]), float(spot[2])))
		else:
			m = minf(m, _ramp(Vector2(x, z).distance_to(spot), SPOT_FLAT, SPOT_FADE))
	# Край карты: там стоят стены мира, и холм под ними оставил бы щель.
	var edge: float = _half - maxf(absf(x), absf(z))
	m = minf(m, _ramp(edge, 0.0, EDGE_FLAT))
	return clampf(m, 0.0, 1.0)


## 0 при value <= flat, 1 при value >= fade, плавно между ними.
static func _ramp(value: float, flat: float, fade: float) -> float:
	if value <= flat:
		return 0.0
	if value >= fade:
		return 1.0
	return smoothstep(0.0, 1.0, (value - flat) / (fade - flat))


## Собрать меш рельефа с коллизией. Возвращает тело, которое кладут в мир.
func build(material: Material) -> StaticBody3D:
	var body := StaticBody3D.new()
	body.name = "Relief"

	var st := SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	# Одна группа сглаживания на весь рельеф.
	#
	# Без неё нормали считаются на каждый треугольник отдельно, и пологий холм
	# рассыпается на шестнадцатиметровые «тарелки» разной яркости — на снимке
	# это выглядело как мусор на текстуре, а не как рельеф. Сглаживание работает
	# только по общим вершинам, поэтому ниже обязателен `index()`.
	st.set_smooth_group(0)
	var steps: int = int(_half * 2.0 / CELL)
	for ix in steps:
		for iz in steps:
			var x0: float = -_half + float(ix) * CELL
			var z0: float = -_half + float(iz) * CELL
			var x1: float = x0 + CELL
			var z1: float = z0 + CELL
			var a := Vector3(x0, height(x0, z0), z0)
			var b := Vector3(x1, height(x1, z0), z0)
			var c := Vector3(x1, height(x1, z1), z1)
			var d := Vector3(x0, height(x0, z1), z1)
			# Кладём ВСЕ клетки, даже совсем плоские.
			#
			# Первый заход пропускал плоские, чтобы не спорить с подложкой мира,
			# и рельеф вышел архипелагом: холмы островами, а по краю каждого
			# острова — ступенька в пару сантиметров. На снимке это выглядело
			# как зелёные тарелки, разбросанные по полю, и я успел списать их
			# сперва на текстуру, потом на нормали. Сплошное полотно ступенек не
			# имеет вовсе, а подложка спрятана под него (см. `_build_ground`).
			_quad(st, a, b, c, d)
	# Сначала слить одинаковые вершины, потом считать нормали: иначе сглаживать
	# нечего — у каждого треугольника свои три вершины, ни одной общей.
	st.index()
	st.generate_normals()
	var mesh := st.commit()

	var view := MeshInstance3D.new()
	view.mesh = mesh
	view.material_override = material
	# Рельеф ТЕНИ НЕ ОТБРАСЫВАЕТ.
	#
	# Полотно на всю карту, освещённое солнцем почти вдоль, ловит собственную
	# тень мозаикой: по полю расходятся зелёные многоугольники чуть темнее
	# остального — классическая «acne» самозатенения на пологой геометрии. На
	# снимке это выглядело как мусор, и я успел списать его сперва на текстуру,
	# потом на нормали, потом на россыпь. Тень от холма на самого себя стоит
	# мало, а картину портит целиком.
	view.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
	body.add_child(view)

	var shape := CollisionShape3D.new()
	shape.shape = mesh.create_trimesh_shape()
	body.add_child(shape)
	return body


static func _quad(st: SurfaceTool, a: Vector3, b: Vector3, c: Vector3, d: Vector3) -> void:
	st.add_vertex(a)
	st.add_vertex(b)
	st.add_vertex(c)
	st.add_vertex(a)
	st.add_vertex(c)
	st.add_vertex(d)
