extends Node
##
## Казна фракций (Этап 10, шаг 0).
##
## Раньше запас ресурсов висел на ПЕРСОНАЖЕ. Это работало, пока на сторону
## приходится ровно один игрок, но ломается сразу в двух местах будущего:
##   - склад должен переживать смерть персонажа (GDD раздел 4.1): нельзя, чтобы
##     всё нажитое фракцией лежало в кармане у того, кого сейчас убьют;
##   - юниты одной фракции должны видеть общий кошелёк (будущий ИИ, GDD 10.8).
##
## Владелец запаса теперь сторона, а не человек. Снаружи ничего не изменилось:
## `player.stock` продолжает работать, только отдаёт казну своей фракции.
##
## Считает и меняет ТОЛЬКО хост. Значения реплицируются всем одним
## синхронизатором — тем же способом, что здоровье и ранения.
##

const FACTIONS := preload("res://scripts/factions.gd")


func _ready() -> void:
	# Раскладываем стартовый запас БЕЗ проверки на хоста: числа константные и
	# одинаковые на всех пирах, а сетевого пира в момент загрузки сцены ещё нет
	# вовсе. Дальше клиентские значения всё равно перезапишет репликация.
	for faction in FACTIONS.COUNT:
		var pile := of(faction)
		if pile == null:
			continue
		pile.amounts = PackedInt32Array(FACTIONS.STARTING_RESOURCES[faction])
		pile.capacity = FACTIONS.starting_capacity(faction)


## Казна стороны. Никогда не возвращает null для корректного номера фракции —
## иначе каждый вызывающий обязан был бы это проверять.
func of(faction: int) -> Node:
	return get_node_or_null(str(clampi(faction, 0, FACTIONS.COUNT - 1)))
