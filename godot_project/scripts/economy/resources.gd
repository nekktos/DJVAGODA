const LABOURER_COST := [0, 0, 12, 0]
## Больше этого батраков не нанять: без потолка стратегия сводится к «нажми
## наём двадцать раз».
const LABOURER_LIMIT := 8
const SQUAD_LIMIT := 12

## Цена лошади и сколько их держит сторона.
##
## Лошадь дороже батрака: батрак носит понемногу и своими ногами, а лошадь —
## это скорость обоза, а с недавних пор ещё и седло под всадника. Потолок в
## дюжину — это две полные упряжки по шесть.
##
## Платим деревом и золотом, а не одним золотом. Первая цена была «30 золота», и
## прогон показал, чего она стоит: золото — самый редкий ресурс в игре, ИИ за
## пять минут не накопил на ОДНУ лошадь и конюшня простояла впустую. Дерево же
## у стороны, которая рубит постоянно, есть всегда — это корм и сбруя, а не
## слиток.
const HORSE_COST := [25, 0, 12, 0]
const HORSE_LIMIT := 12

## Цена протезов по уровню качества. Закрывает заглушку Этапа 3: раньше их
## выдавали бесплатно, потому что экономики ещё не было.
const PROSTHETIC_COST := {
	1: [20, 0, 0, 0],
	2: [10, 0, 30, 40],
	3: [10, 0, 150, 80],
}


static func format_cost(cost: Array) -> String:
	var parts := PackedStringArray()
	for i in COUNT:
		if int(cost[i]) > 0:
			parts.append("%s %d" % [SHORT[i], int(cost[i])])
	return ", ".join(parts) if parts.size() > 0 else "бесплатно"


## Подсказка, ГДЕ взять то, чего не хватило.
##
## Тестер первого playtest встал ровно здесь: «не понял, где источник железа,
## никаких подсказок в игре не увидел». Отказ честно говорил, сколько железа
## нужно, и молчал о том, что железо не рубится и не бьётся — его нет нигде,
## кроме шахты. Пятнадцать минут игры кончились тупиком, и это была одна из
## трёх причин, по которым тестер прекратил.
##
## Подсказываем только по тем ресурсам, которых НЕ ХВАТАЕТ, и только по тем,
## что добываются не руками: про дерево и камень игрок знает и так — он их
## только что бил. Лишняя подсказка на каждый отказ быстро перестаёт читаться.
##
## `have` — любой запас с `get_amount`: кошелёк стороны или склад.
static func shortfall_hint(cost: Array, have: Object) -> String:
	if have == null or not have.has_method("get_amount"):
		return ""
	var short := PackedInt32Array()
	for kind in [Kind.GOLD, Kind.IRON]:
		if int(cost[kind]) > int(have.get_amount(kind)):
			short.append(kind)
	if short.is_empty():
		return ""
	var what: String = NAMES[short[0]]
	if short.size() > 1:
		what = "%s и %s" % [NAMES[short[0]], NAMES[short[1]]]
	return " (%s есть только в шахте: вези караваном или пошли батрака-шахтёра)" % what


## Торговля (Этап 8, GDD раздел 2.1). Экономика единая, платят золотом
## (GDD раздел 8.1) — железо в цене снаряжения это материал, а не вторая валюта.
##
## Цены пока одинаковы для всех. GDD раздел 8.1 говорит, что они должны зависеть
## от отношений между фракциями, но репутации и дипломатии в коде ещё нет —
## см. открытый вопрос в README.
enum Trade { BANDAGES, GEAR, ARROWS }

## Сколько бинтов в пачке и потолок в сумке.
