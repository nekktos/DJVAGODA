## Пустое хранилище нужной длины. Через него заводятся ВСЕ склады, кошельки,
## грузы и кучи: жёсткая четвёрка в коде — это будущая ошибка на границе
## массива, стоит добавить ресурс.
static func empty() -> PackedInt32Array:
	var out := PackedInt32Array()
	out.resize(COUNT)
	return out


## Подогнать хранилище под COUNT. Короткое дополняем нулями, длинное режем.
##
## ЗАЧЕМ. Массивы ресурсов приходят снаружи: из пакета спавна, из сохранения, из
## проверки. Стоит добавить ресурс — и каждый такой массив становится короче
## COUNT, а первый же цикл по COUNT падает за границу. Один раз это уже стоило
## одиннадцати красных наборов разом: еда стала пятым ресурсом, и посыпались
## куча добычи, обоз, склад и стартовые ресурсы.
##
## Правило: всё, что ХРАНИТ ресурсы, подгоняется на входе. Всё, что читает ЦЕНУ,
## терпимо к короткой (см. `at`) — цены остались четвёрками намеренно.
static func fit(values: Array) -> PackedInt32Array:
	var out := empty()
	for i in COUNT:
		out[i] = at(values, i)
	return out


## Сколько этого ресурса в цене. Массив короче COUNT — значит про остальные
## ресурсы цена молчит, и молчание читается нулём: постройки не стоят еды.
static func at(cost: Array, kind: int) -> int:
	if kind < 0 or kind >= cost.size():
		return 0
	return int(cost[kind])


static func format_cost(cost: Array) -> String:
	var parts := PackedStringArray()
	for i in COUNT:
		if at(cost, i) > 0:
			parts.append("%s %d" % [SHORT[i], at(cost, i)])
	return ", ".join(parts) if parts.size() > 0 else "бесплатно"


## Подсказка, ГДЕ взять то, чего не хватило.
##
## Тестер первого playtest встал ровно здесь: «не понял, где источник железа,
## никаких подсказок в игре не увидел». Отказ честно говорил, сколько железа
## нужно, и молчал о том, что железо не рубится и не бьётся — его нет нигде,
## кроме шахты. Пятнадцать минут игры кончились тупиком, и это была одна из
## трёх причин, по которым тестер прекратил.
##
## Подсказываем только по тем ресурсам, которых НЕ ХВАТАЕТ, и только по тем,
## что добываются не руками: про дерево и камень игрок знает и так — он их
## только что бил. Лишняя подсказка на каждый отказ быстро перестаёт читаться.
##
## `have` — любой запас с `get_amount`: кошелёк стороны или склад.
static func shortfall_hint(cost: Array, have: Object) -> String:
	if have == null or not have.has_method("get_amount"):
		return ""
	var short := PackedInt32Array()
	for kind in [Kind.GOLD, Kind.IRON]:
		if at(cost, kind) > int(have.get_amount(kind)):
			short.append(kind)
	if short.is_empty():
		return ""
	var what: String = NAMES[short[0]]
	if short.size() > 1:
		what = "%s и %s" % [NAMES[short[0]], NAMES[short[1]]]
	return " (%s есть только в шахте: вези караваном или пошли батрака-шахтёра)" % what


