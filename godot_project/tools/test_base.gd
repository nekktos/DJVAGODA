extends Node
##
## Общий каркас автопроверок (Этап 10, шаг 0).
##
## ЗАЧЕМ СЧИТАТЬ ВЫПОЛНЕННЫЕ ПРОВЕРКИ, А НЕ ТОЛЬКО ПРОВАЛЫ.
## Когда скрипт под проверкой не компилируется, Godot не роняет сцену — нода
## просто деградирует до базового типа. Все вызовы к ней тихо падают в лог, тест
## доходит до конца, провалов не видит и печатает «все проверки пройдены»,
## не проверив НИЧЕГО. Это уже случилось один раз с лесом на Этапе 8: тест был
## зелёный, а системы не было вовсе.
##
## Поэтому каждый набор объявляет, сколько проверок обязан выполнить, и если их
## меньше — это провал независимо от того, что показали сами проверки.
##
## Наследник задаёт tag/expected_host/expected_client в _init или start(),
## вызывает check() на каждую проверку и finish() в конце.
##

## Как подписываются строки набора: "[лес]", "[бой-тест]" и так далее.
var tag := "тест"
## Сколько проверок обязана выполнить половина хоста и половина клиента.
## Половины разные: клиент обычно проверяет только репликацию.
var expected_host := 1
var expected_client := 1

var _failures := 0
var _ran := 0


## Одна проверка. ok — прошла ли, label — что проверяли, detail — что вышло.
func check(ok: bool, label: String, detail: String) -> void:
	_ran += 1
	if not ok:
		_failures += 1
	print("[%s] %s | %s: %s" % [tag, "OK  " if ok else "ПРОВАЛ", label, detail])


## Сообщение без зачёта: пропуски, пояснения, промежуточные значения.
func note(text: String) -> void:
	print("[%s] %s" % [tag, text])


## Провал без проверки — для случаев «дальше идти нельзя».
func fail(text: String) -> void:
	_failures += 1
	print("[%s] ПРОВАЛ: %s" % [tag, text])


func failures() -> int:
	return _failures


func ran() -> int:
	return _ran


## Подвести итог и выйти с кодом. Вызывать в конце обеих половин.
func finish() -> void:
	var expected: int = expected_host if Net.hosting() else expected_client
	if _ran < expected:
		_failures += 1
		print("[%s] ПРОВАЛ: выполнилось проверок %d из %d — часть кода не отработала"
			% [tag, _ran, expected])
	if _failures == 0:
		print("[%s] все проверки пройдены (%d)" % [tag, _ran])
	else:
		print("[%s] провалено проверок: %d из %d" % [tag, _failures, _ran])
	get_tree().quit(1 if _failures > 0 else 0)
