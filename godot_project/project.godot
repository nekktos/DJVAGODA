; Engine configuration file.
; Project: ДжваГода
; Этап 0 — сетевой фундамент. См. ../GDD.md раздел 9.

config_version=5

[application]

config/name="DzhvaGoda"
config/description="3D action/RTS multiplayer prototype — see /GDD.md and /HANDOFF.md at repo root."
config/version="playtest-3"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Net="*res://scripts/network_manager.gd"
Sfx="*res://scripts/audio/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":87,"script":null)
]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":83,"script":null)
]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":65,"script":null)
]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":68,"script":null)
]
}
jump={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":32,"script":null)
]
}

toggle_camera={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":4194306,"script":null)
]
}
cam_rotate_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":81,"script":null)
]
}
cam_rotate_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":69,"script":null)
]
}

attack={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"device":-1,"button_index":1,"script":null)
]
}
weapon_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":49,"script":null)
]
}
weapon_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":50,"script":null)
]
}
weapon_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":51,"script":null)
]
}

weapon_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":55,"script":null)
]
}

ability_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":52,"script":null)
]
}
ability_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":53,"script":null)
]
}
ability_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":54,"script":null)
]
}

truce={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":89,"script":null)
]
}

bandage={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":66,"script":null)
]
}
interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"device":-1,"physical_keycode":70,"script":null)
]
}

[debug]

; Пишем лог в файл: без него тестировщик не может приложить к отчёту ничего,
; кроме описания словами. Лежит в user://logs/godot.log.
file_logging/enable_file_logging=true

[rendering]

; Нужно для экспорта под macOS universal и arm64: без ETC2 ASTC Godot
; отказывается собирать под Apple Silicon вовсе.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="forward_plus"
